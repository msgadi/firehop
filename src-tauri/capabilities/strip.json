{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "strip",
  "description": "The account strip. Account sessions (remote WhatsApp pages) get no capability at all.",
  "webviews": ["strip"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:menu:default",
    "dialog:allow-ask",
    "allow-roster",
    "allow-add-account",
    "allow-activate-account",
    "allow-move-account",
    "allow-reload-account",
    "allow-remove-account",
    "allow-open-account-editor"
  ]
}
